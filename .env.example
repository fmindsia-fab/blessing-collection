# Loja ativa servida por este deploy (nunca lida fora de lib/store/get-active-store.ts)
STORE_SLUG=blessing-collection

# Modo de resolução de tenant: "env" (padrão, pode omitir) usa STORE_SLUG acima.
# "host" resolve a loja pelo domínio/subdomínio da requisição, lido via
# headers propagados por proxy.ts (ver lib/store/resolve-tenant-from-host.ts).
# TENANT_RESOLUTION_MODE=env

# Domínio apex da plataforma (só usado por proxy.ts quando
# TENANT_RESOLUTION_MODE=host). Subdomínios dele viram lojas automaticamente;
# qualquer outro host é tratado como domínio customizado de alguma loja.
# PLATFORM_DOMAIN=atelifacil.com.br

# Supabase (projeto criado no Milestone 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada para montar o link do produto na mensagem do WhatsApp
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NUNCA definir SUPABASE_SERVICE_ROLE_KEY em ambiente acessível ao client.
# Este MVP não precisa de service_role_key — anon key + RLS cobre todos os casos.
