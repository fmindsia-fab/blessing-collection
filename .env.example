# Loja ativa servida por este deploy (nunca lida fora de lib/store/get-active-store.ts)
STORE_SLUG=blessing-collection

# Modo de resolução de tenant: "env" (padrão, pode omitir) usa STORE_SLUG acima.
# "host" resolve a loja pelo domínio/subdomínio da requisição, lido via
# headers propagados por proxy.ts (ver lib/store/resolve-tenant-from-host.ts).
# TENANT_RESOLUTION_MODE=env

# Domínio apex da plataforma (só usado por proxy.ts quando
# TENANT_RESOLUTION_MODE=host). Subdomínios dele viram lojas automaticamente;
# qualquer outro host é tratado como domínio customizado de alguma loja.
# PLATFORM_DOMAIN=atelifacil.com.br

# Supabase (projeto criado no Milestone 3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada para montar o link do produto na mensagem do WhatsApp
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave de serviço do Supabase (ignora a RLS). SOMENTE servidor, NUNCA com prefixo
# NEXT_PUBLIC_ e nunca em código de navegador. Usada em dois lugares isolados:
# o webhook do Stripe (app/api/webhooks/stripe) e as ações do admin da plataforma
# (lib/platform/service-role-client.ts: excluir contas, listar logins).
# SUPABASE_SERVICE_ROLE_KEY=<...>

# Stripe (assinatura da plataforma). Todas SOMENTE servidor, sem NEXT_PUBLIC_.
# STRIPE_SECRET_KEY: chave secreta (sk_live_... em produção, sk_test_... em testes).
# STRIPE_PRICE_ID: id do preço da assinatura (price_...), usado no Checkout.
# STRIPE_WEBHOOK_SECRET: segredo de assinatura do webhook (whsec_...), que valida
#   os eventos recebidos em /api/webhooks/stripe.
# STRIPE_SECRET_KEY=<...>
# STRIPE_PRICE_ID=<...>
# STRIPE_WEBHOOK_SECRET=<...>

# CAPTCHA (Cloudflare Turnstile) nos formulários de login, cadastro, reenvio de
# confirmação e recuperação de senha. OPCIONAL: sem a chave, nada é exibido nem exigido.
# A chave PÚBLICA (site key) vai aqui; a chave SECRETA vai só no painel do Supabase
# (Authentication > Attack Protection) — nunca no código nem em variável do app.
# Ligue o CAPTCHA no Supabase SOMENTE depois que esta variável estiver no deploy.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<...>
